# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence
#
# `match` is the SHAPE; `confirm` asks the file's size, and the corpus cannot
# run `confirm`.

# --- the rule should fire (real transcripts, 2026-09-09 sweep) ---
match	cd /Users/fredericrous/Developer/Perso/duro-design-system; cat CLAUDE.md
match	cd /Users/fredericrous/Developer/Perso/trade-agents && cat packages/agents/src/agents/_features.py
match	cat -n src/main.rs
match	sed -n 1,140p docs/agent-guard.md
match	sed -n 140,300p crates/amont-runtime/src/live.rs
match	head -200 /tmp/make-check3.log
match	cd ~/Developer/Perso/al-wt/storm-canvas && sed -n '1,400p' app/lib/landscapeDoc.ts

# --- the rule must stay silent ---
# A window.
nomatch	sed -n '95,135p' .github/workflows/ci.yml
nomatch	sed -n 115,140p app/components/risk/RiskMatrix.tsx
nomatch	head -20 build.log
nomatch	tail -5 /tmp/push.log
# Fed onward, or an edit.
nomatch	cat app/lib/mutations/settings-api-keys.test.ts | head -100
nomatch	cat notes.txt | git notes add -F - HEAD
nomatch	cat > /private/tmp/claude-501/x/scratchpad/classify.sh <<'EOF'
nomatch	sed -i 's/^version = .*/version = "1.28.0"/' Cargo.toml
nomatch	sed 's/\x1b\[[0-9;]*m//g' /tmp/v2.log | tail -20
nomatch	cat $DIR/file.ts
