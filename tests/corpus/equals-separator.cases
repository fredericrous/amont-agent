# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence

# --- the rule should fire (from real transcripts, each one a zsh
# `== not found` that aborted the rest of the command) ---
match	sed -n '500,560p' crates/amont-runtime/src/lib.rs; echo ===; sed -n '340,400p' crates/amont/src/main.rs
match	head -80 crates/amont-runtime/src/dispatch.rs; echo ======; head -60 crates/amont-runtime/src/staged_only.rs
match	cd /Users/fredericrous/Developer/Perso/duro-app && cat app/lib/mutations/settings-api-keys.test.ts | head -100 && echo ===== && cat app/test/test-runtime.ts
match	cd /Users/fredericrous/Developer/Perso/homelab && grep -rn "git.daddyshome.fr" --include="*.yaml" kubernetes | head -20; echo ====; sed -n '1,80p' kubernetes/homelab/apps/gitea/gitea-helmrelease.yaml
match	grep -n "sub\|preferred_username" app/lib/services/OidcClient.server.ts | head -30; echo ==SESSION; grep -n "sub" app/lib/session.server.ts | head -20
match	cd ~/Developer/Perso/al-wt/storm-canvas; echo ====DOC-CONSTS; sed -n 44,80p app/lib/landscapeDoc.ts
match	sed -n 220,250p app/routes/value-streams.tsx; echo ====ADDSTAGE====; sed -n 385,405p app/routes/value-streams.tsx
match	npx @duro-app/cli Drawer 2>&1 | head -70; echo ===; npx @duro-app/cli Button 2>&1 | head -60
match	ls packages/dbt-duckdb/models/silver/ && echo === && cat packages/dbt-duckdb/models/silver/silver_benchmark_d.sql
match	sed -n '80,120p' app/styles/storm.css; echo =====; sed -n '750,870p' app/styles/storm.css
# The wait-loop shape: `[ x == y ]` is the same lookup, and it dies on the
# first test.
match	until [ "$st" == "completed" ]; do sleep 10; st=$(gh run view 315 --json status --jq .status); done
match	a=1; if [ "$a" == "1" ]; then echo same; fi

# --- the rule must stay silent ---
# Quoted.
nomatch	grep -n "kind === \|case \"" app/lib/dsl/compile.ts | head -60; echo "=== wc"; wc -l app/lib/dsl/compile.ts
nomatch	cd /Users/fredericrous/Developer/Perso/duro-app && sed -n '60,140p' app/lib/services/CertRevealRepo.server.ts; echo "=== clearCertRenewalId SQL:"; rg -n -A8 'clearCertRenewalId:' app/lib/services/PreferencesRepo.server.ts
nomatch	echo "=== checkout ==="; cat app/routes/billing.checkout.ts | head -60
nomatch	cd /Users/fredericrous/Developer/Perso/application-landscape-wt-flows && sed -n '1,40p' app/routes/share.tsx; echo '=== api.feedback action shape ==='; sed -n '1,50p' app/routes/api.feedback.ts
nomatch	kubectl logs -n duro deploy/duro --tail 40 2>/dev/null | tail -20; echo "=== pod status:"; kubectl get pods -n duro | head -4
# Not a leading `=`, or parsed rather than expanded.
nomatch	echo --- separator ---; ls
nomatch	git log --oneline HEAD^..HEAD
nomatch	curl -s 'https://example.com/x?a==b' | head
nomatch	[[ $a == 1 ]] && echo y
nomatch	if [ "$a" = "1" ]; then echo y; fi
nomatch	python3 -c "print('===')"
