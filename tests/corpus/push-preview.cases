# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence
# --- reviewed 2026-09-28 against the rule as shipped: every push that is not
# --- a dry run is a shape worth confirming. `confirm` decides at run time
# --- (UI repository, UI files, unapproved commit; an unreadable shape is held
# --- only under deny), so tag and --all pushes still match here: under deny
# --- they must reach `confirm` rather than slip past the gate. ---
match	git push -u origin feat/settings-toggle
match	git push origin HEAD:feat/settings-toggle
match	cd /Users/fredericrous/Developer/Perso/duro-app-wt-toast && git fetch origin -q && git rebase origin/main && git push -u origin feat/toast
match	git -C ../duro-app-wt-toast push origin feat/toast
match	git push --all origin
match	git push origin v2.2.0 --tags
nomatch	git push --dry-run origin feat/x
nomatch	git push -n origin feat/x
nomatch	git pull --rebase origin main
nomatch	git ls-remote --heads origin feat/x
nomatch	echo git push origin main
nomatch	gh pr create --fill
nomatch	git push origin main
