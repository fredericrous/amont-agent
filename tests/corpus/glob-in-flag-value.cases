# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence

# --- the rule should fire (from real transcripts, each one a zsh
# `no matches found: --include=…` the tool reported as success) ---
match	grep -rn "value-streams" app/ --include=*.tsx --include=*.ts | head -50
match	grep -rln "home.daddyshome.fr" /Users/fredericrous/Developer/Perso/homelab --include=*.yaml 2>/dev/null | head -20
match	cd /Users/fredericrous/Developer/Perso/homelab && grep -rn "CLUSTER_OUTBOUND_SUBNETS\|CLUSTER_DNS_V4" --include=*.yaml | head -40
match	cd /Users/fredericrous/Developer/Perso/trade-agents && grep -rln "execution_runs" --include=*.sql . | head -20
match	grep -rn "knownIdentity\|config::.*(\"amont" crates/amont-runtime/src --include=*.rs | grep -v test | head -20
match	grep -rl "redhatcop.redhat.io" --include=*.yaml --include=*.yml --include=*.go --include=*.json . 2>/dev/null | sort
match	grep -rln --include=*.meta.ts "" packages/ui/src/components | wc -l
match	grep -rn "fetch_ew_universe_return\|benchmark_return" packages/ --include=*.py | head -30
match	kubectl get pods -n duro -o custom-columns=NAME:.metadata.name,READY:.status.containerStatuses[*].ready
match	grep -rn "cfg(unix)\|cfg(windows)" --include=*.rs crates/*/tests/ | head -80

# --- the rule must stay silent ---
# Quoted: the glob reaches the program.
nomatch	ls .forgejo/workflows/ 2>/dev/null; grep -rIl "image:" --include='*.yaml' --include='*.yml' . 2>/dev/null | grep -v node_modules | head -20
nomatch	grep -rn "foo" app/ --include='*.tsx' --include='*.ts' | head -50
nomatch	grep -rn "bar" src/ --include="*.rs" | head
nomatch	kubectl get pods -o jsonpath='{.items[*].metadata.name}'
nomatch	rg -n --glob '*.ts' "useLinkTarget" app/ | head -20
# No glob in the value.
nomatch	grep -rn "baz" . --exclude-dir=node_modules --include=Makefile
nomatch	kubectl delete pod x --wait=false; kubectl get pods | head
nomatch	git log --format=%h -3
# Opaque, or text.
nomatch	bash -c 'grep -rn foo . --include=*.rs' | head
nomatch	python3 -c "print('--include=*.ts')"
