# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence

# --- the rule should fire ---
match	git push origin v0.9.1
match	git tag -a v0.9.1 3669b7b -m "v0.9.1" && git push origin v0.9.1
match	git push --tags
match	git push origin refs/tags/v1.0.0-rc2
match	git push origin v2

# --- the rule must stay silent ---
# Ordinary branch work publishes nothing.
nomatch	git push -u origin feat/forge-merge-by-hand
nomatch	git push origin main
nomatch	git push --force-with-lease origin fix/ticket-close-race
# A tag whose name is not a version drives no release workflow.
nomatch	git push origin docs-snapshot
nomatch	git push origin verify
nomatch	git push origin feat/v2-rewrite
# Withdrawing a tag publishes nothing; neither does a rehearsal.
nomatch	git push --delete origin v0.9.1
nomatch	git push --dry-run origin v0.9.1
# Creating the tag is not pushing it — `tag-after-commit` owns the chained form.
nomatch	git tag -a v0.9.1 -m "release"
