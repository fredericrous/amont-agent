# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence
#
# A `stat` inside `$( )` is a substitution the lexer blanks, so those real
# failures cannot be represented here; the top-level forms can.

# --- the rule should fire ---
match	SP=/private/tmp/claude-501/x/tasks; stat -f '%Sm %N' -t '%Y-%m-%dT%H:%M:%S%z' $SP/bu37lop4s.output
match	echo "--- local size ---"; stat -f "%z bytes" ~/Downloads/Photos.zip
match	echo "##### ~/.netrc: mode + entries #####"; stat -f '%Sp %Su %N' ~/.netrc
match	echo "--- /Applications device ---"; stat -f '%Sd %N' /Applications /System/Applications /Users/fredericrous
match	grep -iE "ServerAlive|github" ~/.ssh/config 2>/dev/null | head -5; echo "---"; stat -f "%Sm %N" /tmp/tagpush5.log
match	ls -l --time-style=full-iso app/routes/value-streams.tsx 2>/dev/null || stat -f "%Sm %N" -t "%Y-%m-%d %H:%M:%S" app/routes/value-streams.tsx
match	stat -c '%s %n' app/routes/value-streams.tsx
match	stat -c '%y' ~/.netrc
match	stat --format='%s' /tmp/sw.js

# --- the rule must stay silent ---
nomatch	timeout 60 ssh -o BatchMode=yes admin@192.168.1.42 'find /share/TempSsd/k3s -maxdepth 2 -exec stat -c "%n %u:%g" {} \;'
nomatch	kubectl exec -n garage lmdb-salvage -- sh -c 'stat -f /var/lib/garage'
nomatch	stat -f /var/lib/garage
nomatch	grep -rn "stat -f" docs/ | head
nomatch	df -h / /System/Volumes/Data | cat
nomatch	stat -L Cargo.toml
