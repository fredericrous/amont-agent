# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence

# --- reviewed 2026-09-04 against the rule as shipped: the shape of a push
# --- fires; a dry run, a hook-skipping push and amont's own notes push do not.
# --- (`confirm` narrows the fire further at run time; the corpus replays
# --- `examine` alone, so these judge shape only.) ---
match	git push -u origin feat/selection-bar-verbs
match	git push origin HEAD
match	cd /Users/fredericrous/Developer/Perso/website-builder-wt-followups && git fetch origin -q && git rebase origin/main && git push -u origin feat/selection-bar-followups
nomatch	git push origin v2.2.0 --tags
nomatch	git push origin main
nomatch	git push --dry-run origin main
nomatch	git push -n origin feat/x
nomatch	git push --no-verify -u origin feat/selection-bar-followups
nomatch	git push origin refs/notes/amont-attest:refs/notes/amont-attest
nomatch	git pull --rebase origin main
nomatch	git fetch origin -q && git rebase origin/main
nomatch	git ls-remote --heads origin feat/selection-bar-verbs
nomatch	gh pr create --fill
