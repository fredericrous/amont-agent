# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence

# --- the rule should fire ---
# The 2026-09-27 incident, both forms, verbatim: 139 ghcr.io pages from one egress IP.
match	count() { host=$1; repo=$2; tok=$3; url="https://$host/v2/$repo/tags/list?n=1000"; pages=0; total=0; first=""; while [ -n "$url" ] && [ $pages -lt 400 ]; do hdr=$(mktemp); body=$(curl -sS -D $hdr ${tok:+-H "Authorization: Bearer $tok"} "$url"); n=$(echo "$body" | jq '.tags|length' 2>/dev/null); [ -z "$first" ] && first=$n; total=$((total+${n:-0})); pages=$((pages+1)); link=$(grep -i '^link:' $hdr | sed -E 's/.*<([^>]+)>.*/\1/' | tr -d '\r'); rm $hdr; [ -n "$link" ] && { case "$link" in http*) url=$link;; *) url="https://$host$link";; esac; } || url=""; done; echo "$host/$repo: pages=$pages first_page=$first total=$total"; }; T=$(curl -s "https://auth.docker.io/token?service=registry.docker.io&scope=repository:envoyproxy/envoy:pull" | jq -r .token); count registry-1.docker.io envoyproxy/envoy "$T"; count quay.io cilium/cilium-envoy ""; T=$(curl -s "https://ghcr.io/token?scope=repository:immich-app/immich-machine-learning:pull" | jq -r .token); count ghcr.io immich-app/immich-machine-learning "$T"
match	count() { host=$1; repo=$2; tok=$3; url="https://$host/v2/$repo/tags/list?n=1000"; pages=0; total=0; first=""; while [ -n "$url" ] && [ $pages -lt 400 ]; do hdr=$(mktemp); body=$(curl -sS -D $hdr -H "Authorization: Bearer $tok" "$url"); n=$(echo "$body" | jq '.tags|length' 2>/dev/null); [ -z "$first" ] && first=$n; total=$((total+${n:-0})); pages=$((pages+1)); link=$(grep -i '^link:' $hdr | sed -E 's/.*<([^>]+)>.*/\1/' | tr -d '\r'); rm $hdr; if [ -n "$link" ]; then case "$link" in http*) url=$link;; *) url="https://$host$link";; esac; else url=""; fi; done; echo "$host/$repo: pages=$pages first_page=$first total=$total"; }; T=$(curl -s "https://auth.docker.io/token?service=registry.docker.io&scope=repository:envoyproxy/envoy:pull" | jq -r .token); count registry-1.docker.io envoyproxy/envoy "$T"; T=$(curl -s "https://ghcr.io/token?scope=repository:immich-app/immich-machine-learning:pull" | jq -r .token); count ghcr.io immich-app/immich-machine-learning "$T"
match	for i in {1..60}; do curl -s "https://ghcr.io/v2/org/img$i/tags/list"; done
match	gh api --paginate /repos/fredericrous/homelab/actions/runs --jq '.workflow_runs[].id'
match	i=0; while [ $i -lt 200 ]; do curl -s https://registry-1.docker.io/v2/; i=$((i+1)); done
match	curl -s 'https://example.com/page/[1-500]'
match	while true; do curl -s https://api.github.com/rate_limit; sleep 1; done
match	for r in a b c d e f g h i j; do for t in 1 2 3 4 5 6; do curl -sI "https://ghcr.io/v2/org/$r/manifests/$t"; done; done

# --- the rule must stay silent ---
nomatch	curl -s https://ghcr.io/v2/
nomatch	for f in *.yaml; do kubectl apply -f "$f"; done
nomatch	for i in 1 2 3; do curl -fsS https://git.daddyshome.fr/api/healthz && break; sleep 5; done
nomatch	until gh pr view 47 --json state --jq .state | grep -q MERGED; do sleep 15; done
nomatch	for i in $(seq 1 300); do curl -s http://localhost:8080/health; done
nomatch	for i in {1..100}; do curl -s http://api.default.svc.cluster.local/ping; done
nomatch	f() { for i in {1..100}; do curl -s https://ghcr.io/v2/; done; }; echo defined
nomatch	for i in {1..20}; do curl -s "https://ghcr.io/v2/x$i/tags/list"; done
nomatch	cargo test --workspace
nomatch	i=0; while [ $i -lt 400 ]; do i=$((i+1)); done; echo curl
