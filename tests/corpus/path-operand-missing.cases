# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence
#
# `match` is the SHAPE; `confirm` asks the filesystem whether the path is
# there, and the corpus cannot run `confirm`.

# --- the rule should fire (from real transcripts, each one a path that was
# not there and a call that reported success) ---
match	cd /Users/fredericrous/Developer/Perso/duro-app && grep -rn "useLinkTarget\|LinkTargetProvider\|openLinksInNewTab" app e2e docs --include="*.ts" --include="*.tsx"
match	grep -n "id:" app/lib/rules.ts | head -20; echo "--- how ids are built:"; grep -n "const id\|f.id" app/lib/rules.ts | head -20
match	cd /Users/fredericrous/Developer/Perso/homelab && ls bootstrap/internal/commands/ && grep -n "Phase\|phase" bootstrap/internal/commands/install.go | head -40
match	cd /Users/fredericrous/Developer/Perso/duro-app && cat node_modules/@duro-app/ui/dist/components/Icon.d.ts | head -30
match	wc -l app/components/storm/StormBoard.tsx app/components/storm/storm.css app/lib/bandRoute.ts
match	cd ~/Developer/Perso/al-wt/storm-canvas && sed -n 115,200p app/components/risk/RiskMatrix.tsx; echo ---SERIALIZED; grep -n 'interface SerializedGridLayout' app/lib/grid.ts
match	cd /Users/fredericrous/Developer/Perso/governance-audit-wt-attest && find .forgejo .github -type f | sort
match	find node_modules/react-strict-dom/dist -name "*Props*" | head -20
match	cd /Users/fredericrous/Developer/Perso/homelab && head -3 kubernetes/homelab/platform-foundation/crds/istio-base-crds.yaml
match	grep -n 'no-raw-html-element' eslint.config.mjs
# The shape; whether app/ is there is confirm's question.
match	grep -rn "size={[0-9]" app/ | wc -l

# --- the rule must stay silent ---
# Deliberate probes.
nomatch	grep -rn "application-landscape:" ~/Developer/Perso/homelab/kubernetes/ 2>/dev/null | grep -v Binary | head -10
nomatch	ls node_modules/@fredericrous/grid/ 2>/dev/null; cat node_modules/@fredericrous/grid/package.json 2>/dev/null | head -30
nomatch	[ -f docs/design/adr.md ] && cat docs/design/adr.md
nomatch	cat CHANGELOG.md || echo "no changelog"
# Sequences that may have just created the path.
nomatch	mkdir -p docs/design && cat docs/design/adr.md
nomatch	git worktree add ../x-wt-y -b feat/y origin/main && cat ../x-wt-y/Cargo.toml
nomatch	npm run build > build.log 2>&1; tail -20 build.log
# Remote, unknowable, or not a reader.
nomatch	ssh admin@192.168.1.42 'head -5 /share/Media2/.musicaudit/report.txt'
nomatch	kubectl exec -n forgejo deploy/forgejo -- sh -c 'cat /data/gitea/conf/app.ini | head -20'
nomatch	cat > /private/tmp/claude-501/x/scratchpad/classify.sh <<'EOF'
nomatch	cat $DIR/file.ts
nomatch	cat app/lib/*.ts | wc -l
nomatch	git log --oneline -8 && echo "--- tags ---" && git tag --sort=-creatordate | head -10
