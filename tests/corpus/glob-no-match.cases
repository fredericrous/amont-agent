# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence
#
# `match` here is the SHAPE — `confirm` decides at run time whether the
# pattern really matches nothing, and the corpus cannot run `confirm`.

# --- the rule should fire (from real transcripts, each one a zsh
# `no matches found` the tool reported as success) ---
match	cd /Users/fredericrous/Developer/Perso/duro-app && grep -rn "external_id\|externalId" scripts/seed-dev.ts app/lib/db/migrations/*.sql 2>/dev/null | head -20
match	cd /Users/fredericrous/Developer/Perso/homelab-wt-duro-forgejo && rg -n -A12 'kustomize-validate:' .forgejo/workflows/*.yml .github/workflows/*.yml 2>/dev/null | head -30
match	cd /Users/fredericrous/Developer/Perso/duro-app && ls .claude && cat .claude/*.md 2>/dev/null | head -150
match	cd /Users/fredericrous/Developer/Perso/duro-app && grep -rn "tabIndex" node_modules/react-strict-dom/dist/types/dom/*.d.ts 2>/dev/null | head -5; ls node_modules/react-strict-dom/dist 2>/dev/null | head
match	grep -rn 'no-restricted-imports' -A 60 node_modules/@duro-app/eslint-config/dist/*.js 2>/dev/null | head -120
match	cd /Users/fredericrous/Developer/Perso/application-landscape-wt-pwa-update && grep -rn "max-warnings\|53\b" .husky/* scripts/*.mjs scripts/*.sh 2>/dev/null | head
match	cd /Users/fredericrous/Developer/Perso/homelab && grep -rn 'image:.*lldap' kubernetes/homelab/apps/lldap/*.yaml kubernetes/homelab/apps/lldap*.yaml
match	cd /Users/fredericrous/Developer/Perso/ticket-vision-wt-duro-v1 && grep -l "xsdmeew" build/client/assets/*.css build/server/assets/*.css 2>/dev/null
match	cd /Users/fredericrous/Developer/Perso/customer-vision-wt-duro-v1 && cat .github/workflows/*.yml 2>/dev/null | head -60
match	grep -rn "Trigger" node_modules/@duro-app/ui/dist/components/Menu*.js 2>/dev/null | head -10; ls node_modules/@duro-app/ui/dist/components | head -40
match	cd /Users/fredericrous/Developer/Perso/application-landscape-wt-checkout-e2e && head -30 .github/workflows/*.yml | head -50

# --- the rule must stay silent ---
# The existence question, asked of nothing but patterns.
nomatch	ls .amont* 2>/dev/null
nomatch	ls -d /Users/fredericrous/Developer/Perso/*-wt-forgejo
nomatch	cd /Users/fredericrous/Developer/Perso/homelab && ls kubernetes/homelab/apps/argo*
# Quoted: the program does its own matching.
nomatch	git ls-files '*.md' | head -20
nomatch	find . -name '*.go' | xargs grep -l TODO
nomatch	rg -n --glob '*.yml' 'runs-on' .forgejo/workflows | head
nomatch	git tag -l 'v1.*' | tail -3
nomatch	echo 'app/lib/db/migrations/*.sql'
# Opaque, or another rule's shape.
nomatch	bash -c 'cat .claude/*.md' 2>/dev/null | head
nomatch	grep -rn "value-streams" app/ --include=*.tsx | head
