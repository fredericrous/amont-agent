# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence

# --- the rule should fire (from real transcripts) ---
# The one true positive in 32,401 commands: a stray `cat > file` with nothing
# on stdin, which blocked for the tool's whole ten-minute clock (2026-09-08).
match	cd ~/Developer/Perso/homelab-wt-node-schematics && cat > /private/tmp/claude-501/-Users-fredericrous-Developer-Perso/8e1225e8-139e-4677-a06e-placeholder 2>/dev/null; git push -u origin feat/per-node-schematics; echo "push exit $?"
match	cat > notes.md
match	sudo tee /etc/hosts
match	python3
match	sort | uniq -c

# --- the rule must stay silent ---
# Version and help flags exit before reading anything — a third of the first
# measurement's firings, all of them this shape.
nomatch	services/playbook-scorer/.venv/bin/python --version 2>/dev/null; echo done
nomatch	.venv/bin/python --version 2>&1
nomatch	node -v && npm -v
nomatch	PATH=/private/tmp/claude-501/node-v24.19.0-darwin-x64/bin:$PATH node -v && node --version
nomatch	python3 --version; uv --version
# Fed: a `<` redirect, a here-string, a process substitution, a pipe.
nomatch	bash -n < scripts/deploy.sh
nomatch	grep -n -E 'def content_hash|def _hash|hashlib' < <(git show HEAD:src/hash.py)
nomatch	python3 <<< 'print(1+1)'
nomatch	bc <<< "2^10"
nomatch	cat <(sort a.txt) <(sort b.txt)
nomatch	ls | sort | uniq -c | sort -rn | head
nomatch	find . -name '*.go' | xargs grep -l TODO
nomatch	echo x | sudo tee /etc/hosts > /dev/null
# Not a reader given these arguments.
nomatch	cat -n file.txt > out.txt
nomatch	grep -rn "tee /tmp" docs/
nomatch	grep -e error file.log
nomatch	sed -n '95,135p' .github/workflows/ci.yml
nomatch	sed -i 's/a/b/' file.txt
nomatch	jq -r '.id' resp.json
nomatch	jq -n '{a:1}'
nomatch	awk -f prog.awk data.txt
nomatch	python3 -c 'print(1)'
nomatch	python3 -m json.tool f.json
nomatch	bash -c 'echo hi'
nomatch	node -e 'console.log(1)'
# A reader inside a string is text.
nomatch	echo 'cat > file'
