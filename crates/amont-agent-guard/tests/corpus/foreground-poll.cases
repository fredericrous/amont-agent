# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence

# --- the rule should fire (from real transcripts) ---
match	cd /Users/fredericrous/Developer/Perso/trade-agents-liq3 && until [ "$(gh pr checks 247 2>/dev/null | grep -cE '\bpending\b')" = "0" ]; do sleep 30; done; echo COMPLETED
match	until [ "$(gh run view 31044200911 --json status --jq .status)" = "completed" ]; do sleep 45; done; echo "DONE"; gh run view 31044200911 --json status,conclusion
match	cd /Users/fredericrous/Developer/Perso/trade-agents-liq3 && for i in $(seq 1 18); do n=$(gh pr checks 247 2>/dev/null | grep -cE '\bpending\b'); if [ "$n" = "0" ]; then echo COMPLETED; break; fi; sleep 30; done
match	until grep -q "^exit=" $S/push.log 2>/dev/null; do sleep 10; done; tail -12 $S/push.log
match	cd ~/Developer/Perso/attest && gh run watch 33107191361 --exit-status > /dev/null 2>&1; gh run view 33107191361 --json conclusion
match	while true; do sleep 5; done
match	i=0; while [ $i -lt 80 ]; do out=$(gh run list --repo fredericrous/duro-app --limit 5 --json status); sleep 15; i=$((i+1)); done

# --- the rule must stay silent ---
nomatch	sleep 2; gh pr checks 229
nomatch	sleep 20 && gh run list --repo fredericrous/amont --workflow release.yaml --limit 1
nomatch	for f in det2 det pea tcn3 icb ds; do echo "== $f"; head -3 $f.csv; done
nomatch	for w in macro-loader-1786341600 events-loader-1786342200; do echo "===== $w ====="; kubectl -n trade-agents get workflow $w; done
nomatch	cargo test --workspace
nomatch	gh run view 33107414395 --json conclusion,jobs --jq '.conclusion'
nomatch	timeout 240 npm run test < /dev/null > /tmp/duro-app-test.log 2>&1; echo "EXIT=$?"
