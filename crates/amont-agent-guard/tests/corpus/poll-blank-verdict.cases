# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain poll-blank-verdict --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test.
#
# Every positive below is the same defect: a wait that ends on any value other
# than the one it names, so a failed lookup's empty string reads as an answer.
# The `$rev != $start_rev` forms are the same bug wearing a different hat — a
# blank is not equal to the starting revision either, so a dropped connection
# reads as "it changed".
match	cd /Users/fredericrous/Developer/Perso/homelab-wt-forgejo-migration\ntries=0\nuntil [ $tries -ge 40 ]; do\n  git fetch origin main -q 2>/dev/null; git fetch forgejo main -q 2>/dev/null\n  gm=$(git rev-parse origin/main); fm=$(git rev-parse forgejo/main)\n  if [ "$gm" != "$fm" ]; then\n    if git merge-base --is-ancestor "$fm" "$gm" 2>/dev/null; then\n      git -c hook.skip=pre-push-branch-protect push forgejo origin/main:main >/dev/null 2>&1 && echo "ff-synced forgejo to ${gm:0:10}"\n    elif git merge-base --is-ancestor "$gm" "$fm" 2>/dev/null; then\n      echo "forgejo ahead (${fm:0:10}) — github will catch up via push-mirror"\n    else\n      echo "DIVERGED github=${gm:0:10} forgejo=${fm:0:10} — MANUAL MERGE NEEDED"; exit 1\n    fi\n  fi\n  tries=$((tries+1)); sleep 600\ndone\necho "sync loop ended (6h40m window)"
