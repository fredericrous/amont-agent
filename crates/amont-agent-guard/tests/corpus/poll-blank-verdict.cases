match	TOK=$(awk '/machine git.daddyshome.fr/{print $6}' ~/.netrc); SHA=a3168a9efdd1cb24a627133fc912ca758dcb5141; ELAPSED=0; until [ $ELAPSED -ge 2400 ]; do\n  curl -sS --max-time 45 --cert ~/.config/mtls/daddyshome-client.crt --key *** -H "Authorization: token $TOK" "https://git.daddyshome.fr/api/v1/repos/fredericrous/governance-audit/commits/$SHA/status" -o /tmp/st.json\n  RES=$(python3 -c '\nimport json\nd=json.load(open("/tmp/st.json"))\nsts=d.get("statuses",[])\nprint(d.get("state","none"), len(sts), "|", " ".join(s.get("status","?")+":"+s.get("context","?") for s in sts))\n')\n  echo "[t=${ELAPSED}s] $RES"\n  STATE=$(echo "$RES" | cut -d' ' -f1)\n  NST=$(echo "$RES" | cut -d' ' -f2)\n  if [ "$STATE" != "pending" ] && [ "$NST" != "0" ]; then echo "DONE-FINAL"; break; fi\n  if [ "$NST" = "0" ] && [ $ELAPSED -ge 300 ]; then echo "NO-CI-AFTER-5MIN"; break; fi\n  sleep 30; ELAPSED=$((ELAPSED+30))\ndone
match	TOK=$(awk '/machine git.daddyshome.fr/{print $6}' ~/.netrc); check() { curl -sS --cert ~/.config/mtls/daddyshome-client.crt --key *** -H "Authorization: token $TOK" "https://git.daddyshome.fr/api/v1/repos/fredericrous/homelab/commits/$1/status" | python3 -c "import json,sys; print(json.load(sys.stdin).get('state'))"; }; for i in $(seq 1 40); do a=$(check c8118c75759a65552cf695f7b8f7fdf2227e7cd6); b=$(check d621c8800603ff9bf627b93193df13a24b0cf01d); echo "poll $i: san=$a retire=$b"; if [ "$a" != "pending" ] && [ "$b" != "pending" ]; then break; fi; sleep 30; done
match	i=0; until [ $i -ge 20 ]; do st=$(gh pr checks 130 --repo fredericrous/amont 2>/dev/null | grep windows | awk -F'\\t' '{print $2}'); if [ "$st" != "pending" ] && [ -n "$st" ]; then echo "windows: $st"; break; fi; i=$((i+1)); sleep 30; done; gh pr checks 130 --repo fredericrous/amont | grep -vE "pass|skipping" | head -2; echo "empty means green"
# --- negatives: shapes that must stay silent -------------------------------
nomatch	for i in $(seq 1 200); do s=$(curl -sS https://x/status | jq -r .state); case "$s" in success|failure|error) echo "CI: $s"; exit 0 ;; esac; sleep 20; done
nomatch	until [ "$s" = "completed" ]; do s=$(gh run view 1 --json status --jq .status); sleep 20; done
nomatch	while [ "$s" != "completed" ]; do s=$(gh run view 1 --json status --jq .status); sleep 20; done
nomatch	for i in 1 2 3; do if [ "$i" != "2" ]; then echo "$i"; fi; sleep 1; done
nomatch	s=$(git rev-parse HEAD); if [ "$s" != "$other" ]; then echo differ; fi
nomatch	kubectl -n flux-system rollout status deploy/source-controller --timeout=300s
nomatch	while read -r line; do echo "$line"; done < /tmp/x
