match	cd /Users/fredericrous/Developer/Perso/homelab; GRA=infrastructure/cloud/kubeconfig.yaml; echo 'polling for new artifact (publish-manifests -> ghcr -> Flux)...'; for i in $(seq 1 24); do rev=$(kubectl --kubeconfig=$GRA -n flux-system get ocirepository flux-system -o jsonpath='{.status.artifact.revision}' 2>/dev/null | cut -c1-24); if [ "$rev" != "latest@sha256:88d1513efb" ]; then echo "  [$((i*20))s] NEW artifact: $rev"; break; fi; echo "  [$((i*20))s] still 88d1513e..."; sleep 20; done; echo '--- force source + kustomization reconcile to speed it up:'; kubectl --kubeconfig=$GRA -n flux-system annotate ocirepository flux-system reconcile.fluxcd.io/requestedAt="r$(date +%s 2>/dev/null||echo x)" --overwrite 2>/dev/null | sed 's/^/  /'; sleep 5; echo "  OCI revision now: $(kubectl --kubeconfig=$GRA -n flux-system get ocirepository flux-system -o jsonpath='{.status.artifact.revision}' 2>/dev/null | cut -c1-24)"
match	cd /Users/fredericrous/Developer/Perso/homelab; GRA=infrastructure/cloud/kubeconfig.yaml; base=$(kubectl --kubeconfig=$GRA -n flux-system get ocirepository flux-system -o jsonpath='{.status.artifact.revision}' 2>/dev/null); echo 'waiting for artifact + reconcile...'; for i in $(seq 1 18); do rev=$(kubectl --kubeconfig=$GRA -n flux-system get ocirepository flux-system -o jsonpath='{.status.artifact.revision}' 2>/dev/null); if [ "$rev" != "$base" ]; then kubectl --kubeconfig=$GRA -n flux-system annotate kustomization cloud-controllers reconcile.fluxcd.io/requestedAt="r$(date +%s 2>/dev/null||echo x)" --overwrite >/dev/null 2>&1; break; fi; sleep 15; done; sleep 25; echo "=== dkim-manager pruned? ==="; echo "  HelmRelease: $(kubectl --kubeconfig=$GRA -n flux-system get helmrelease dkim-manager 2>&1 | grep -c NotFound | xargs -I{} sh -c '[ {} = 1 ] && echo GONE || echo present')"; echo "  pods: $(kubectl --kubeconfig=$GRA get pods -A 2>/dev/null | grep -c dkim-manager) remaining"; echo "=== stalwart still healthy (SES path unaffected) ==="; kubectl --kubeconfig=$GRA -n stalwart get pods 2>/dev/null | grep -iE 'stalwart-[0-9a-f]|NAME' | sed 's/^/  /'; echo "  cloud-controllers kustomization: $(kubectl --kubeconfig=$GRA -n flux-system get kustomization cloud-controllers -o jsonpath='{.status.conditions[?(@.type==\\"Ready\\")].status}' 2>/dev/null)"
