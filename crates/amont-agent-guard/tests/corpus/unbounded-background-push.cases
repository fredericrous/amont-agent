# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence
#
# The corpus replays `examine` only. Whether the call ran in the background is
# `confirm`'s question (a payload field), so these lines judge the COMMAND:
# a push with no `timeout` wrapper is a match here even when, in the session,
# it ran in the foreground and `confirm` would have declined it.

# --- the rule should fire (from real transcripts, 2026-10-08) ---
match	cd ~/Developer/Perso/happier && git push origin dev > /tmp/happier-push.log 2>&1; echo "push exit=$?" >> /tmp/happier-push.log; tail -5 /tmp/happier-push.log; git ls-remote --heads origin
match	cd ~/Developer/Perso/amont-wt-empty-new-ref && git push -u origin fix/empty-new-ref-range > /tmp/amont-push.log 2>&1; echo "push rc=$?"; tail -4 /tmp/amont-push.log
match	cd ~/Developer/Perso/amont-agent-wt-nothing-new && git push -u origin fix/push-guards-nothing-new > /tmp/aa-push.log 2>&1; echo "push rc=$?"

# --- the rule must stay silent ---
nomatch	cd ~/Developer/Perso/happier && timeout 1800 git push origin dev > /tmp/happier-push.log 2>&1; echo "push rc=$?"
nomatch	timeout -k 30 1800 git push -u origin feat/x
nomatch	git push --dry-run origin dev > /tmp/p.log 2>&1
nomatch	git push origin main
nomatch	git push -u origin feat/x 2>&1
nomatch	git ls-remote origin refs/heads/dev
nomatch	gh pr checks 87 -R fredericrous/amont-agent
nomatch	git -C ~/Developer/Perso/amont fetch origin -q
