# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain forge-status-stale-row --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test.
#
# All seven are real commands from the 2026-09-10 session that produced the
# rule. The positives are one reduction repeated: keep the first row of an
# append-only status list, which pinned a homelab deploy PR at `pending` while
# all 22 of its checks were green.
#
# The first negative is the REMEDY, and it is the one that matters. It opens
# with the same `c not in best` clause as the defect, so the `or` branch is the
# only thing telling them apart — if the rule ever widens over that, it starts
# arguing with its own advice.
match	TOK=$(awk '/machine git.daddyshome.fr/{print $6}' ~/.netrc)\ncurl -sS --cert ~/.config/mtls/daddyshome-client.crt --key ~/.config/mtls/daddyshome-client.key \\\n  -H "Authorization: token $TOK" \\\n  "https://git.daddyshome.fr/api/v1/repos/fredericrous/homelab/commits/861a02d380b1bc36d5b673a39ad7dea253861ca0/statuses" \\\n| python3 -c "\nimport sys,json\nd=json.load(sys.stdin)\nseen={}\nfor r in (d if isinstance(d,list) else []):\n    c=r.get('context')\n    if c not in seen: seen[c]=r.get('status')\nbad={k:v for k,v in seen.items() if v not in ('success','skipped')}\nprint(('PENDING/FAIL %d/%d: ' % (len(bad), len(seen))) + ', '.join(bad) if bad else 'ALL GREEN (%d checks)' % len(seen))\n"
match	SHA=$(git rev-parse HEAD) && TOK=$(awk '/machine git.daddyshome.fr/{print $6}' ~/.netrc)\nuntil curl -sS --cert ~/.config/mtls/daddyshome-client.crt --key ~/.config/mtls/daddyshome-client.key \\\n    -H "Authorization: token $TOK" \\\n    "https://git.daddyshome.fr/api/v1/repos/fredericrous/homelab/commits/$SHA/statuses" \\\n  | python3 -c "\nimport sys,json\nd=json.load(sys.stdin)\nseen={}\nfor r in (d if isinstance(d,list) else []):\n    c=r.get('context')\n    if c not in seen: seen[c]=r.get('status')\nbad=[k for k,v in seen.items() if v not in ('success','skipped')]\nraise SystemExit(0 if seen and not bad else 1)\n"; do sleep 20; done\necho "ALL CHECKS COMPLETE"
match	curl -sS -H "Authorization: token $TOK" "https://git.daddyshome.fr/api/v1/repos/fredericrous/application-landscape/commits/7f79b528345e001684bec8fbfbe8e61d6776daac/statuses" | python3 -c "\nimport sys,json\nd=json.load(sys.stdin)\nseen={}\nfor r in (d if isinstance(d,list) else []):\n    c=r.get('context')\n    if c not in seen: seen[c]=(r.get('status'), r.get('description'))\nfor k,(st,desc) in seen.items(): print(f'{st} | {k} | {desc}')\n"
nomatch	curl -sS -H "Authorization: token $TOK" "https://git.daddyshome.fr/api/v1/repos/fredericrous/homelab/commits/$SHA/statuses" | python3 -c "\nimport sys,json\nTERMINAL={'success','failure','error','skipped'}\nd=json.load(sys.stdin)\nbest={}\nfor r in (d if isinstance(d,list) else []):\n    c=r.get('context'); st=r.get('status')\n    if c not in best or (best[c] not in TERMINAL and st in TERMINAL):\n        best[c]=st\nbad={k:v for k,v in best.items() if v not in ('success','skipped')}\nprint('ALL GREEN' if not bad else bad)\n"
nomatch	curl -sS --cert ~/.config/mtls/daddyshome-client.crt --key ~/.config/mtls/daddyshome-client.key -H "Authorization: token $TOK" "https://git.daddyshome.fr/api/v1/repos/fredericrous/application-landscape/commits/2154719791140288645c0e2a8ae53ea719cb88a5/status" | python3 -c "\nimport sys,json\nd=json.load(sys.stdin)\nprint('state:', d.get('state'))\n"
nomatch	curl -sS -H "Authorization: token $TOK" "https://git.daddyshome.fr/api/v1/repos/fredericrous/homelab/commits/$SHA/statuses" | python3 -c "\nimport sys,json\nd=json.load(sys.stdin)\nrows=[r for r in (d if isinstance(d,list) else []) if 'bootstrap' in (r.get('context') or '')]\nfor r in rows:\n    print(r.get('status'), '|', r.get('updated_at'), '|', r.get('description'))\n"
nomatch	curl -sS "https://git.daddyshome.fr/api/v1/repos/fredericrous/homelab/actions/tasks?limit=10" | python3 -c "\nimport sys,json\nd=json.load(sys.stdin)\nseen={}\nfor r in d.get('workflow_runs', []):\n    if r.get('name') not in seen: seen[r['name']]=r.get('status')\nprint(seen)\n"
