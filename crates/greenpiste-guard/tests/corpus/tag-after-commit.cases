# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence

# --- the rule should fire (from real transcripts) ---
match	git commit -q -m "chore(release): 0.9.97" && git tag v0.9.97 && git push origin v0.9.97 2>&1
match	git add -A && git commit -m "chore: bump" ; git tag -a v2.0.0 -m "v2.0.0"
match	cd /Users/fredericrous/Developer/Perso/attest && git commit -F msg.txt && git tag v0.1.0 && git push origin main v0.1.0

# --- the rule must stay silent ---
nomatch	git tag v0.10.0 a278ecb && test "$(git rev-parse v0.10.0)" = "$(git rev-parse origin/main)" && git push origin v0.10.0
nomatch	git tag v1.28.0 3c7a31d0e1433d8eec2e92f52fb71d6c56711692 && git push origin v1.28.0
nomatch	git tag v0.9.99 fd7ee1c && git rev-parse v0.9.99 && git push origin v0.9.99 2>&1
nomatch	git commit -m x && git tag -l | tail -3
nomatch	git tag -d v1.9.0; git show HEAD:Cargo.toml | grep version
nomatch	git commit -m "tag: v1" && git push
nomatch	git log --oneline -1 && git tag --contains HEAD
