# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence

# --- the rule should fire (2026-09-21, both ran under zsh and produced a
# silent wrong result: `$2` empty, `$3`/`$4` empty) ---
match	TOK=$(awk '/machine git.daddyshome.fr/{print $6}' ~/.netrc); for rp in "sre-agent 41" "website-builder 164" "stealth-fetch 17"; do set -- $rp; code=$(curl -sS -X POST "https://git.daddyshome.fr/api/v1/repos/fredericrous/$1/pulls/$2/merge" -d '{"Do":"merge"}' -o /dev/null -w '%{http_code}'); echo "$1 #$2 merge http=$code"; done
match	for w in "4180 vfs 2026-09-21T08:20:00Z 2026-09-21T08:54:00Z" "4243 overlay 2026-09-21T12:44:00Z 2026-09-21T13:22:00Z"; do set -- $w; echo "### run $1 ($2) $3..$4"; done
match	files=$(git grep -l -- '--storage-driver=vfs' -- .forgejo/workflows); for f in $files; do sed -i 's/ --storage-driver=vfs//g' "$f"; done

# --- more from the transcripts (reviewed 2026-09-21): pairs split with
# `set --`, and a `for` over a variable holding a `grep -l`/`find` result ---
match	git fetch origin -q && for pair in "fix/issue-10 fix/issue-6" "fix/issue-10 fix/issue-7" "fix/issue-6 fix/issue-7"; do set -- $pair; echo "### $1 + $2"; if git merge-tree --write-tree --name-only origin/$1 origin/$2 > /tmp/mt.txt 2>&1; then echo "clean"; else echo "CONFLICTS:"; sed -n '2,20p' /tmp/mt.txt; fi; done
match	cd ~/Developer/Perso/homelab && f=$(command grep -rlE 'chart: homelab-preview-operator|name: homelab-preview-operator' kubernetes --include='*.yaml' | head -3); echo "$f"; for x in $f; do command grep -nE 'version:|gitRepo|github|gitProvider|forge|token|secret|args|extraArgs|migrationCheck|probeImage|cveEnrich' "$x" | head -16 | cut -c1-140; done
match	cd ~/Developer/Perso && for spec in "amont feat/gate-evidence" "amont-agent feat/rule-mining" "aval feat/relevance"; do set -- $spec; git -C $1 fetch -q origin; if git -C $1 merge-base --is-ancestor origin/main origin/$2; then echo "$1 $2: based on current origin/main"; else echo "$1 $2: BEHIND origin/main by $(git -C $1 rev-list --count origin/$2..origin/main) commit(s): $(git -C $1 log --oneline origin/$2..origin/main | tr '\\n' ';')"; fi; done
match	cd ~/Developer/Perso/homelab-preview-operator && grep -n 'cloudnative-pg' go.mod | head -3; d=$(find ~/go/pkg/mod/github.com/cloudnative-pg -maxdepth 1 -type d 2>/dev/null | sort | tail -2); echo "$d"; for x in $d; do grep -rn -A25 'FixedConfigurationParameters = ' "$x"/pkg/postgres/*.go 2>/dev/null | grep -E '"[a-z_]+":' | tr -d '\\t' | tr '\\n' ' ' | cut -c1-900; done; echo; find ~/go/pkg/mod/github.com/cloudnative-pg -name '*.go' -path '*postgres*' 2>/dev/null | xargs grep -ln 'FixedConfigurationParameters' 2>/dev/null | head -2
match	echo "=== uplink AFTER (was 7/20 immediately pre-rollout, 13/20 earlier)"\nfor tgt in "1.1.1.1 443" "8.8.8.8 53" "9.9.9.9 443"; do\n  set -- $tgt; ok=0\n  for i in $(seq 1 20); do nc -z -G 3 $1 $2 >/dev/null 2>&1 && ok=$((ok+1)); done\n  echo "  $1:$2 -> $ok/20"\ndone\necho "=== github clone reachability (the CI symptom)"\nok=0; for i in 1 2 3 4 5; do curl -sS -o /dev/null --max-time 8 https://github.com/ >/dev/null 2>&1 && ok=$((ok+1)); done; echo "  github.com $ok/5"

# --- the rule must stay silent ---
# Deliberate, quoted, or already split.
nomatch	set -- "$@"; echo "$1"
nomatch	for f in "$@"; do echo "$f"; done
nomatch	for f in "$files"; do echo "$f"; done
# zsh splits an unquoted command substitution.
nomatch	for f in $(git grep -l -- '--storage-driver=vfs' -- .forgejo/workflows); do sed -i 's/ --storage-driver=vfs//g' "$f"; done
nomatch	for JID in $(kubectl -n postgres exec postgres-apps-3 -c postgres -- psql -U postgres -d forgejo -Atc "SELECT id FROM action_run_job WHERE run_id=4243;"); do echo "$JID"; done
# Not the idiom.
nomatch	set -euo pipefail; echo start
nomatch	set -- one two three; echo "$2"
nomatch	for i in 1 2 3; do echo "$i"; done
nomatch	for f in $dir/*.yaml; do echo "$f"; done
nomatch	echo $HOME; ls $dir
nomatch	printf '%s\n' "sre-agent 41" "stealth-fetch 17" | while read -r r n; do echo "$r #$n"; done
